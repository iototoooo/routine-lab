# 画面（ブラウザ）に埋め込まれる公開値だけを書く。コピーして .env.local を作る（.env.local は Git に含めない）。
# service_role キー・VAPID 秘密鍵・CRON_SECRET・DB パスワードは絶対にここへ書かない
# （それらは `supabase secrets set` で Edge Function にだけ置く。docs/plan.md 4.1 節）。

# Supabase ダッシュボード → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# anon（legacy）または publishable（sb_publishable_...）キー
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# VAPID 公開鍵（base64url、87文字）。秘密鍵とペアで生成し、秘密鍵は Supabase の secrets にだけ置く
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
